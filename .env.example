# .env.example — copy to .env.local and fill in real values.
# Real .env* files are gitignored. Never commit secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Anon (publishable) key — safe for the browser; RLS is the real gate.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-ONLY. Bypasses row-level security.
# Never import it in client code, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (transactional email: OTP codes, notifications) ─────────────────
RESEND_API_KEY=
EMAIL_FROM="Strimer <no-reply@yourdomain.com>"

# ── Cloudflare Turnstile (bot protection on signup and posting) ────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
